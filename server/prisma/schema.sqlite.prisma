generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  regular
  admin
}

enum FileStatus {
  uploading
  processing
  ready
  failed
}

enum OrderStatus {
  pending
  paid
  failed
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(regular)
  createdAt    DateTime @default(now()) @map("created_at")

  orders        Order[]
  uploadedFiles File[]  @relation("UploadedBy")
  labels        Label[]

  @@map("users")
}

model File {
  id               String     @id @default(uuid())
  title            String
  description      String
  priceCents       Int        @map("price_cents")
  currency         String     @default("usd")
  numRows          Int?       @map("num_rows")
  sizeBytes        BigInt?    @map("size_bytes")
  originalFilename String?    @map("original_filename")
  r2KeyFull        String     @map("r2_key_full")
  r2KeySample      String?    @map("r2_key_sample")
  sampleUrl        String?    @map("sample_url")
  status           FileStatus @default(uploading)
  uploadedBy       String?    @map("uploaded_by")
  createdAt        DateTime   @default(now()) @map("created_at")
  /// Set when an admin removes the dataset from the catalog. The row (and the
  /// stored full file) is kept so existing buyers keep their access.
  deletedAt        DateTime?  @map("deleted_at")

  uploader User?   @relation("UploadedBy", fields: [uploadedBy], references: [id])
  orders   Order[]

  @@map("files")
}

model Order {
  id                       String      @id @default(uuid())
  userId                   String      @map("user_id")
  fileId                   String      @map("file_id")
  amountCents              Int         @map("amount_cents")
  currency                 String      @default("usd")
  stripeCheckoutSessionId  String?     @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId    String?     @unique @map("stripe_payment_intent_id")
  status                   OrderStatus @default(pending)
  createdAt                DateTime    @default(now()) @map("created_at")
  paidAt                   DateTime?   @map("paid_at")

  // --- buyer-owned customisation of a purchased item ---
  customTitle       String?   @map("custom_title")
  customDescription String?   @map("custom_description")
  archivedAt        DateTime? @map("archived_at")
  /// Soft delete by the buyer: hidden from their purchases, but the order
  /// record itself is never removed.
  deletedAt         DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])
  file File @relation(fields: [fileId], references: [id])
  labels OrderLabel[]

  @@map("orders")
}

model Label {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  user   User         @relation(fields: [userId], references: [id])
  orders OrderLabel[]

  @@unique([userId, name])
  @@map("labels")
}

model OrderLabel {
  orderId String @map("order_id")
  labelId String @map("label_id")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([orderId, labelId])
  @@map("order_labels")
}
