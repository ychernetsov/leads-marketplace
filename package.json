{
  "name": "@leads-marketplace/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "nx run-many -t serve -p server client --output-style=stream",
    "dev:mocks": "npm run db:push:mocks && npm run db:generate:mocks && node scripts/ensure-mocks-seed.mjs && MOCKS=true concurrently -k -n server,client -c blue,magenta \"nx serve server -c mocks --output-style=stream\" \"wait-on -d 500 -t 180000 http-get://localhost:3000/ && nx serve client -c mocks --output-style=stream\"",
    "dev:server": "nx serve server --output-style=stream",
    "dev:client": "nx serve client --output-style=stream",
    "db:up": "docker start leads-pg || docker run -d --name leads-pg -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=leads_marketplace -p 5432:5432 postgres:16-alpine",
    "db:down": "docker stop leads-pg",
    "db:seed": "cd server && npx tsx prisma/seed.ts",
    "db:push:mocks": "cd server && MOCKS=true npx prisma db push",
    "db:generate:mocks": "cd server && MOCKS=true npx prisma generate",
    "db:seed:mocks": "cd server && MOCKS=true npx tsx prisma/seed-dev.ts",
    "db:setup:mocks": "npm run db:push:mocks && npm run db:generate:mocks && npm run db:seed:mocks",
    "db:migrate": "cd server && npx prisma migrate dev",
    "db:generate": "cd server && npx prisma generate",
    "db:studio": "cd server && npx prisma studio"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nx/esbuild": "23.0.1",
    "@nx/eslint": "23.0.1",
    "@nx/eslint-plugin": "23.0.1",
    "@nx/jest": "23.0.1",
    "@nx/js": "23.0.1",
    "@nx/node": "^23.0.1",
    "@nx/react": "^23.0.1",
    "@nx/vite": "23.0.1",
    "@nx/web": "23.0.1",
    "@nx/workspace": "23.0.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "~30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "babel-jest": "~30.3.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.27.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jest": "~30.3.0",
    "jest-environment-jsdom": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jiti": "2.4.2",
    "nx": "23.0.1",
    "prettier": "~3.6.2",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.0.0",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "^5.101.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
